rules_version = '2';

// オンライントランプ（cards_*）のルール。ゲームを追加してもここは変更しない。
// 細かい役の正しさは検証しない（身内向け）。他人の手札が読めないこと・他人の番に操作できないことを保証する。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/cards_rooms/$(roomId));
    }
    function isMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/cards_rooms/$(roomId)/players/$(request.auth.uid));
    }
    function isHost(roomId) {
      return signedIn() && roomDoc(roomId).data.hostUid == request.auth.uid;
    }

    // 6桁コード -> ルームID の対応表（コードで参加するために、ルーム本体とは別に誰でもgetできる）
    match /cards_codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /cards_rooms/{roomId} {
      // 招待URLから参加するため、ルームIDを知っていればgetできる。一覧は自分がホストのものだけ（掃除用）
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.hostUid == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.status == 'waiting';
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      allow update: if signedIn() && (
        // ホストは何でも変更できる（gameId・options・status を含む）
        resource.data.hostUid == request.auth.uid
        // 参加・退出（ホスト退出時は残った人へ引き継ぎ）
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'nextSeat', 'hostUid', 'updatedAt']) &&
          (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members) &&
          (request.resource.data.members.size() <= resource.data.members.size() || resource.data.status == 'waiting') &&
          (request.resource.data.hostUid == resource.data.hostUid ||
            (!(resource.data.hostUid in request.resource.data.members) &&
              request.resource.data.hostUid in request.resource.data.members))
        )
        // 操作のたびに更新日時だけ更新する
        || (isMember(roomId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']))
        // 最後の手で終了にする
        || (isMember(roomId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status == 'finished')
      );

      match /players/{uid} {
        allow read: if isMember(roomId);
        allow create: if signedIn() && request.auth.uid == uid &&
          request.auth.uid in getAfter(/databases/$(database)/documents/cards_rooms/$(roomId)).data.members;
        // 本人は自由に更新。handCount・totalPoints はゲーム処理のため参加者全員が更新できる
        allow update: if isMember(roomId) && (
          request.auth.uid == uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handCount', 'totalPoints']));
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(roomId));
      }

      match /state/current {
        allow read: if isMember(roomId);
        // 配布・スキップ・次のゲームはホスト、通常の操作は手番の人
        allow create: if isHost(roomId);
        allow update: if isMember(roomId) && (resource.data.turnUid == request.auth.uid || isHost(roomId));
        allow delete: if isHost(roomId);
      }

      match /hands/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && (
          request.auth.uid == uid ||
          (isHost(roomId) && roomDoc(roomId).data.status == 'dealing'));
        allow delete: if isHost(roomId);
      }

      // 山札（山札を使うゲームだけ）。ホストだけが読める形にはできない：各プレイヤーが自分の操作で引くため
      match /deck/current {
        allow read, write: if isMember(roomId);
      }

      match /transfers/{id} {
        allow create: if isMember(roomId) && request.resource.data.from == request.auth.uid;
        allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
        // 受け取った側が received を立てる
        allow update: if signedIn() && resource.data.to == request.auth.uid;
      }
    }
  }
}
